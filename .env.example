# Alpha Vantage API Key
# Get your free API key from: https://www.alphavantage.co/support/#api-key
# Note: Free tier has 25 requests/day limit, so caching is enabled
ALPHA_VANTAGE_API_KEY=your_api_key_here

# StockData.org API Key
# Get your free API key from: https://www.stockdata.org/
# Note: Free tier has 100 requests/day limit, 3 symbols per request
STOCKDATA_API_KEY=your_api_key_here

# Public canonical URL used by metadata, sitemap, and robots.txt
NEXT_PUBLIC_SITE_URL=https://www.tradivex.com

# Optional Google AdSense configuration. Leave unset until the site is approved.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Firebase Web app configuration used only by Contact, Submit Tool, and Newsletter forms.
# Add the same variables in Vercel Project Settings before enabling form persistence.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase App Check reCAPTCHA v3 site key (public, not a secret)
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
