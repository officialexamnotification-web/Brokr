# Alpha Vantage API Key
# Get your free API key from: https://www.alphavantage.co/support/#api-key
# Note: Free tier has 25 requests/day limit, so caching is enabled
ALPHA_VANTAGE_API_KEY=your_api_key_here

# StockData.org API Key
# Get your free API key from: https://www.stockdata.org/
# Note: Free tier has 100 requests/day limit, 3 symbols per request
STOCKDATA_API_KEY=your_api_key_here
