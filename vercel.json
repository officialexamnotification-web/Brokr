{
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "tradivex.com" }],
      "destination": "https://www.tradivex.com/:path*",
      "permanent": true
    }
  ],
  "routes": [
    {
      "src": "/(category|tool|region|calculators?|blog|compare|comparison|directory|latest-additions|tools|market|markets|forex|brokers|crypto-exchanges|stock-brokers|cfd-brokers|prop-firms|trading-tools|trading|investing|investment|stocks|crypto|options|futures|economic-calendar|compare-tools|about-us|contact-us|affiliate-disclosure|methodology|privacy|terms)(/.*)?/?$",
      "status": 410,
      "headers": {
        "X-Robots-Tag": "noindex, noarchive",
        "Cache-Control": "public, max-age=3600"
      }
    }
  ]
}
